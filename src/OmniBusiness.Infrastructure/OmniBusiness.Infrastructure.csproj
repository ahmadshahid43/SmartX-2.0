<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OmniBusiness.Domain\OmniBusiness.Domain.csproj" />
    <ProjectReference Include="..\OmniBusiness.Application\OmniBusiness.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnablePostgresProvider)' == 'true'">
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LocalJson is the default for restricted office laptops. Enable this only for a Postgres/Supabase deployment build. -->
    <EnablePostgresProvider Condition="'$(EnablePostgresProvider)' == ''">false</EnablePostgresProvider>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnablePostgresProvider)' != 'true'">
    <Compile Remove="Persistence\PostgresWorkspaceRepository.cs" />
  </ItemGroup>

</Project>
